APP_NAME="Medicube API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Dar_es_Salaam

# The React app's origin (used for CORS). Comma-separate several origins.
FRONTEND_URL=http://localhost:5173

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=skincare_shop
DB_USERNAME=postgres
DB_PASSWORD=andreas@2006

# File-based drivers keep the API free of extra session/cache tables.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public
LOG_CHANNEL=stack
LOG_LEVEL=debug

MAIL_MAILER=log
MAIL_FROM_ADDRESS="orders@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Personal access tokens expire after this many minutes (null = never).
SANCTUM_TOKEN_EXPIRATION=10080

# ---- Shop ----
ORDER_NUMBER_PREFIX=SKN
SHOP_CURRENCY=TZS

# ---- Payments ----
# "sandbox" is for local development only: nothing is marked PAID until a
# signed callback arrives (use `php artisan payments:simulate`).
PAYMENT_DEFAULT_GATEWAY=sandbox
PAYMENT_SANDBOX_SECRET=change-me-local-webhook-secret
# Fill these in when you integrate a real Tanzanian provider.
PAYMENT_PROVIDER_BASE_URL=
PAYMENT_PROVIDER_CLIENT_ID=
PAYMENT_PROVIDER_CLIENT_SECRET=
PAYMENT_PROVIDER_WEBHOOK_SECRET=

# ---- First super admin (created by `php artisan db:seed`) ----
ADMIN_NAME="Store Owner"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe!2026
